{
  "name": "@jimrarras/coolify-mcp",
  "version": "0.4.2",
  "description": "MCP server for self-hosted Coolify instances",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimrarras/coolify-mcp.git"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "bin": {
    "coolify-mcp": "dist/cli/index.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:tsc": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "probe": "tsx src/scripts/probe.ts",
    "typecheck": "tsc --noEmit",
    "ci:prebuild": "echo no prebuild gates",
    "ci:postbuild": "git diff --exit-code dist/ THIRD-PARTY-NOTICES.txt",
    "ci:e2e": "echo no e2e tests",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:stack",
    "check:stack": "node scripts/check-stack.mjs",
    "prepublishOnly": "pnpm run check && pnpm test && pnpm run build && git diff --exit-code dist/ THIRD-PARTY-NOTICES.txt"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.0",
    "esbuild": "^0.28.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "ssh2": "^1.16.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.14.0"
}
